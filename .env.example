# ---------------------------------------------------------------------------
# Creator Distribution Platform - example environment file
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials, payment keys, or
# creator media. Every value below is a local-development default.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL + pgvector) --------------------------------------
# Host `db` is the docker-compose service name. Use `localhost` when running
# the API directly on the host.
POSTGRES_USER=cdp
POSTGRES_PASSWORD=cdp
POSTGRES_DB=cdp
POSTGRES_PORT=5432

# SQLAlchemy URL used by the API and by Alembic.
DATABASE_URL=postgresql+psycopg://cdp:cdp@db:5432/cdp

# --- API service -----------------------------------------------------------
APP_ENV=development
API_PORT=8000

# Comma-separated list of browser origins allowed to call the public API.
# The Vite dev server default is http://localhost:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8888,http://127.0.0.1:8888

# Slug of the creator seeded by `python -m app.seed_demo`.
DEMO_CREATOR_SLUG=demo

# --- Frontend build-time configuration (Vite) -------------------------------
# `fixtures` = bundled demo data, no backend required (default, used by Netlify).
# `api`      = fetch live data from VITE_API_BASE_URL.
VITE_DATA_MODE=fixtures

# Base URL of the FastAPI service. Only read by the browser when
# VITE_DATA_MODE=api. This is a public URL - never place secrets here.
VITE_API_BASE_URL=http://localhost:8000

# Slug of the creator whose storefront is rendered. Change this to point the
# same build at a different creator - branding comes from the creator record.
VITE_CREATOR_SLUG=demo

# --- Deferred integrations (NOT configured in CDP-001) ----------------------
# These are intentionally left empty. See docs/architecture/adr/0001-platform-foundation.md.
# Payment provider credentials: eligibility must be verified before any real
# transaction is enabled. Do not add a default processor.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
